<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DSFix.InBattleNaming</AssemblyName>
    <RootNamespace>DSFix</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Description>Culture-accurate promoted troop names for Distinguished Service and The Old Realms</Description>
    <Company>xmarre</Company>
    <Authors>xmarre</Authors>
    <Copyright>Copyright © xmarre 2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="$(BannerlordReferenceVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
